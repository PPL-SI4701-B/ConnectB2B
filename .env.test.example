# =====================================================================
# Kredensial Akun Test untuk E2E Playwright (FR-01..FR-29)
# ---------------------------------------------------------------------
# 1. Salin file ini menjadi `.env.test`  ->  copy .env.test.example .env.test
# 2. Isi email & password akun test yang SUDAH TERVERIFIKASI di Supabase.
# 3. Akun-akun ini dipakai login helper untuk menguji FR yang butuh sesi.
#
# CATATAN: jangan commit `.env.test` (sudah masuk .gitignore).
# =====================================================================

# URL target test (default localhost). Untuk uji ke Vercel, ganti ke domain produksi.
E2E_BASE_URL=http://localhost:3000

# Perlambat gerakan klik (ms) agar terlihat jelas saat demo --headed. 0 = secepatnya.
E2E_SLOWMO=300

# --- Akun UMKM (sudah terverifikasi) ---
E2E_UMKM_EMAIL=umkm@test.com
E2E_UMKM_PASSWORD=password123

# --- Akun Industri (sudah terverifikasi) ---
E2E_INDUSTRI_EMAIL=industri@test.com
E2E_INDUSTRI_PASSWORD=password123

# --- Akun Admin ---
E2E_ADMIN_EMAIL=admin@test.com
E2E_ADMIN_PASSWORD=password123
